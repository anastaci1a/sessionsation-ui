# Only public dependencies; build this image from this repository.
FROM node:22.18.0-bookworm-slim AS node
FROM rust:1.95.0-bookworm
RUN rustup component add rustfmt clippy --toolchain 1.95.0
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pil fonts-dejavu-core ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
